# Spotify app credentials: https://developer.spotify.com/dashboard
SPOTIFY_CLIENT_ID=your_spotify_client_id
SPOTIFY_CLIENT_SECRET=your_spotify_client_secret
# Must match a Redirect URI registered in the dashboard. Spotify requires 127.0.0.1, not localhost.
SPOTIFY_REDIRECT_URI=http://127.0.0.1:8000/auth/spotify/callback
# Where the Vue app is served (OAuth lands back here; also the CORS origin).
FRONTEND_URL=http://localhost:5173
